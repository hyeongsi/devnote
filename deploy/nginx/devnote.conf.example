server {
    listen 80;
    listen [::]:80;
    server_name devnote.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name devnote.example.com;

    ssl_certificate /etc/letsencrypt/live/devnote.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/devnote.example.com/privkey.pem;

    root /var/www/devnote;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
